            sh:path <http://dbpedia.org/ontology/titleLanguage> ],
        [ sh:class xsd:string ;
            sh:path <http://dbpedia.org/ontology/eTeatrId> ],
        [ sh:datatype <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/director> ],
        [ sh:datatype <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/setDesigner> ],
        [ sh:datatype <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/makeupArtist> ],
        [ sh:class xsd:double ;
            sh:path <http://dbpedia.org/ontology/gross> ],
        [ sh:class xsd:double ;
            sh:path <http://dbpedia.org/ontology/filmRuntime> ],
        [ sh:class xsd:string ;
            sh:path <http://dbpedia.org/ontology/iafdId> ],
        [ sh:class xsd:string ;
            sh:path <http://dbpedia.org/ontology/amgid> ],
        [ sh:class xsd:string ;
            sh:path <http://dbpedia.org/ontology/allcinemaId> ],
        [ sh:datatype <http://dbpedia.org/ontology/Company> ;
            sh:path <http://dbpedia.org/ontology/producedBy> ],
        [ sh:class xsd:string ;
            sh:path <http://dbpedia.org/ontology/afdbId> ],
        [ sh:class xsd:string ;
            sh:path <http://dbpedia.org/ontology/bgafdId> ],
        [ sh:class xsd:string ;
            sh:path <http://dbpedia.org/ontology/filmColourType> ],
        [ sh:class xsd:string ;
            sh:path <http://dbpedia.org/ontology/eurobabeIndexId> ],
        [ sh:datatype <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/deputyDirector> ],
        [ sh:class xsd:string ;
            sh:path <http://dbpedia.org/ontology/egafdId> ],
        [ sh:class xsd:string ;
