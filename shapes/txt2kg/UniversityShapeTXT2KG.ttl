@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/UniversityShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:nonNegativeInteger ;
            sh:path <http://dbpedia.org/ontology/numberOfPostgraduateStudents> ],
        [ sh:datatype xsd:string ;
            sh:path <http://dbpedia.org/ontology/latinName> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/leader> ],
        [ sh:class <http://dbpedia.org/ontology/River> ;
            sh:path <http://dbpedia.org/ontology/river> ],
        [ sh:path <http://dbpedia.org/ontology/sportsOffered> ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:path <http://dbpedia.org/ontology/numberOfUndergraduateStudents> ],
        [ sh:datatype rdf:langString ;
            sh:path <http://dbpedia.org/ontology/longName> ],
        [ sh:path <http://dbpedia.org/ontology/academicStaffSize> ],
        [ sh:datatype xsd:string ;
            sh:path <http://dbpedia.org/ontology/motto> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/founder> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/president> ],
        [ sh:class <http://dbpedia.org/ontology/GovernmentType> ;
            sh:path <http://dbpedia.org/ontology/governmentType> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/patronSaint> ],
        [ sh:class <http://dbpedia.org/ontology/PopulatedPlace> ;
            sh:path <http://dbpedia.org/ontology/largestCity> ],
        [ sh:path <http://dbpedia.org/ontology/outlookRanking> ],
        [ sh:class <http://dbpedia.org/ontology/Legislature> ;
            sh:path <http://dbpedia.org/ontology/legislature> ],
        [ sh:path <http://dbpedia.org/ontology/wasGivenTheTechnicalCampusStatusBy> ],
        [ sh:path <http://dbpedia.org/ontology/hasToItsNortheast> ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:path <http://dbpedia.org/ontology/numberOfDoctoralStudents> ],
        [ sh:datatype xsd:string ;
            sh:path <http://dbpedia.org/ontology/officialSchoolColour> ],
        [ sh:datatype xsd:string ;
            sh:path <http://dbpedia.org/ontology/established> ],
        [ sh:class <http://dbpedia.org/ontology/City> ;
            sh:path <http://dbpedia.org/ontology/city> ],
        [ sh:path <http://dbpedia.org/ontology/hasToItsNorthwest> ],
        [ sh:class <http://dbpedia.org/ontology/Work> ;
            sh:path <http://dbpedia.org/ontology/anthem> ],
        [ sh:class <http://dbpedia.org/ontology/Organisation> ;
            sh:path <http://dbpedia.org/ontology/affiliation> ],
        [ sh:class <http://dbpedia.org/ontology/City> ;
            sh:path <http://dbpedia.org/ontology/capital> ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:path <http://dbpedia.org/ontology/staff> ],
        [ sh:class <http://dbpedia.org/ontology/EthnicGroup> ;
            sh:path <http://dbpedia.org/ontology/ethnicGroup> ],
        [ sh:class <http://dbpedia.org/ontology/PopulatedPlace> ;
            sh:path <http://dbpedia.org/ontology/neighboringMunicipality> ],
        [ sh:path <http://dbpedia.org/ontology/elevationAboveTheSeaLevel> ],
        [ sh:class <http://dbpedia.org/ontology/PopulatedPlace> ;
            sh:path <http://dbpedia.org/ontology/headquarter> ],
        [ sh:path <http://dbpedia.org/ontology/isPartOf> ],
        [ sh:path <http://dbpedia.org/ontology/hasToItsWest> ],
        [ sh:datatype rdf:langString ;
            sh:path <http://dbpedia.org/ontology/leaderTitle> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/director> ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:path <http://dbpedia.org/ontology/location> ],
        [ sh:datatype xsd:string ;
            sh:path <http://dbpedia.org/ontology/postalCode> ],
        [ sh:class <http://dbpedia.org/ontology/Country> ;
            sh:path <http://dbpedia.org/ontology/country> ],
        [ sh:path <http://dbpedia.org/ontology/sportGoverningBody> ],
        [ sh:path <http://dbpedia.org/ontology/campus> ],
        [ sh:path <http://dbpedia.org/ontology/religion> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/dean> ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:path <http://dbpedia.org/ontology/numberOfStudents> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/rector> ],
        [ sh:class <http://dbpedia.org/ontology/PopulatedPlace> ;
            sh:path <http://dbpedia.org/ontology/state> ],
        [ sh:path <http://dbpedia.org/ontology/nickname> ] ;
    sh:targetClass <http://dbpedia.org/ontology/University> .

