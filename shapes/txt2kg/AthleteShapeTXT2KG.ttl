        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:path <http://dbpedia.org/ontology/birthPlace> ],
        [ sh:path <http://dbpedia.org/ontology/currentteam> ],
        [ sh:path <http://dbpedia.org/ontology/currentclub> ],
        [ sh:datatype xsd:gYear ;
            sh:path <http://dbpedia.org/ontology/birthYear> ],
        [ sh:class <http://dbpedia.org/ontology/EthnicGroup> ;
            sh:path <http://dbpedia.org/ontology/ethnicGroup> ],
        [ sh:path <http://dbpedia.org/ontology/isPartOf> ],
        [ sh:class <http://dbpedia.org/ontology/SportsLeague> ;
            sh:path <http://dbpedia.org/ontology/league> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/chairman> ],
        [ sh:datatype xsd:date ;
            sh:path <http://dbpedia.org/ontology/birthDate> ],
        [ sh:datatype xsd:date ;
            sh:path <http://dbpedia.org/ontology/foundingDate> ],
        [ sh:path <http://dbpedia.org/ontology/timeZone> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/coach> ],
        [ sh:datatype xsd:string ;
            sh:path <http://dbpedia.org/ontology/draftRound> ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:path <http://dbpedia.org/ontology/ground> ],
        [ sh:class <http://dbpedia.org/ontology/SportsTeam> ;
            sh:path <http://dbpedia.org/ontology/club> ],
        [ sh:datatype rdf:langString ;
            sh:path <http://dbpedia.org/ontology/leaderTitle> ],
        [ sh:datatype xsd:double ;
            sh:path <http://dbpedia.org/ontology/height> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/leader> ],
