            sh:path <http://dbpedia.org/ontology/generalManager> ],
        [ sh:datatype xsd:string ;
            sh:path <http://dbpedia.org/ontology/utcOffset> ],
        [ sh:datatype xsd:double ;
            sh:path <http://dbpedia.org/ontology/areaTotal> ],
        [ sh:datatype xsd:gYear ;
            sh:path <http://dbpedia.org/ontology/draftYear> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/manager> ],
        [ sh:class <http://dbpedia.org/ontology/Work> ;
            sh:path <http://dbpedia.org/ontology/anthem> ],
