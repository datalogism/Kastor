            sh:path <http://dbpedia.org/ontology/populationMetroDensity> ],
        [ sh:datatype xsd:gYear ;
            sh:path <http://dbpedia.org/ontology/foundingYear> ],
        [ sh:class <http://dbpedia.org/ontology/EducationalInstitution> ;
            sh:path <http://dbpedia.org/ontology/almaMater> ],
        [ sh:class <http://dbpedia.org/ontology/Language> ;
            sh:path <http://dbpedia.org/ontology/officialLanguage> ],
        [ sh:class <http://dbpedia.org/ontology/City> ;
            sh:path <http://dbpedia.org/ontology/capital> ],
