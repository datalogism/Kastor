            sh:path <http://dbpedia.org/ontology/gridReference> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/leader> ],
        [ sh:class <http://dbpedia.org/ontology/Award> ;
            sh:path <http://dbpedia.org/ontology/award> ],
        [ sh:path <http://dbpedia.org/ontology/religion> ],
        [ sh:datatype rdf:langString ;
            sh:path <http://dbpedia.org/ontology/birthName> ],
        [ sh:datatype xsd:double ;
            sh:path <http://dbpedia.org/ontology/areaMetro> ],
        [ sh:datatype xsd:string ;
            sh:path <http://dbpedia.org/ontology/areaCode> ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
