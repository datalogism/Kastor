@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/FoodShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:double ;
            sh:path <http://dbpedia.org/ontology/carbohydrate> ],
        [ sh:datatype rdf:langString ;
            sh:path <http://dbpedia.org/ontology/alternativeName> ],
        [ sh:datatype xsd:double ;
            sh:path <http://dbpedia.org/ontology/protein> ],
        [ sh:datatype xsd:double ;
            sh:path <http://dbpedia.org/ontology/course> ],
        [ sh:path <http://dbpedia.org/ontology/dishVariation> ],
        [ sh:class <http://dbpedia.org/ontology/Agent> ;
            sh:path <http://dbpedia.org/ontology/creator> ],
        [ sh:datatype rdf:langString ;
            sh:path <http://dbpedia.org/ontology/leaderTitle> ],
        [ sh:datatype xsd:double ;
            sh:path <http://dbpedia.org/ontology/fat> ],
        [ sh:path <http://dbpedia.org/ontology/division> ],
        [ sh:datatype rdf:langString ;
            sh:path <http://dbpedia.org/ontology/demonym> ],
        [ sh:class <http://dbpedia.org/ontology/Currency> ;
            sh:path <http://dbpedia.org/ontology/currency> ],
        [ sh:class <http://dbpedia.org/ontology/Species> ;
            sh:path <http://dbpedia.org/ontology/family> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/leader> ],
        [ sh:path <http://dbpedia.org/ontology/order> ],
        [ sh:class <http://dbpedia.org/ontology/Country> ;
            sh:path <http://dbpedia.org/ontology/country> ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:path <http://dbpedia.org/ontology/region> ],
        [ sh:path <http://dbpedia.org/ontology/isPartOf> ],
        [ sh:class <http://dbpedia.org/ontology/Language> ;
            sh:path <http://dbpedia.org/ontology/language> ],
        [ sh:class <http://dbpedia.org/ontology/City> ;
            sh:path <http://dbpedia.org/ontology/capital> ],
        [ sh:path <http://dbpedia.org/ontology/mainIngredient> ],
        [ sh:path <http://dbpedia.org/ontology/genus> ],
        [ sh:datatype xsd:string ;
            sh:path <http://dbpedia.org/ontology/servingTemperature> ],
        [ sh:path <http://dbpedia.org/ontology/ingredient> ],
        [ sh:class <http://dbpedia.org/ontology/EthnicGroup> ;
            sh:path <http://dbpedia.org/ontology/ethnicGroup> ] ;
    sh:targetClass <http://dbpedia.org/ontology/Food> .

