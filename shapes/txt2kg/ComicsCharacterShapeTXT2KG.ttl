@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<http://shaclshapes.org/ComicsCharacterShape> a sh:NodeShape ;
    sh:property [ sh:path <http://dbpedia.org/ontology/firstAired> ],
        [ sh:class <http://dbpedia.org/ontology/Organisation> ;
            sh:path <http://dbpedia.org/ontology/distributor> ],
        [ sh:path <http://dbpedia.org/ontology/lastAired> ],
        [ sh:class <http://dbpedia.org/ontology/City> ;
            sh:path <http://dbpedia.org/ontology/city> ],
        [ sh:class <http://dbpedia.org/ontology/Agent> ;
            sh:path <http://dbpedia.org/ontology/creator> ],
        [ sh:path <http://dbpedia.org/ontology/fullName> ],
        [ sh:class <http://dbpedia.org/ontology/Agent> ;
            sh:path <http://dbpedia.org/ontology/foundedBy> ],
        [ sh:class <http://dbpedia.org/ontology/Country> ;
            sh:path <http://dbpedia.org/ontology/nationality> ],
        [ sh:path <http://dbpedia.org/ontology/firstAppearanceInFilm> ],
        [ sh:datatype rdf:langString ;
            sh:path <http://dbpedia.org/ontology/alternativeName> ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:path <http://dbpedia.org/ontology/birthPlace> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/child> ],
        [ sh:class <http://dbpedia.org/ontology/Award> ;
            sh:path <http://dbpedia.org/ontology/award> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/keyPerson> ],
        [ sh:path <http://dbpedia.org/ontology/broadcastedBy> ],
        [ sh:path <http://dbpedia.org/ontology/series> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/voice> ],
        [ sh:class <http://dbpedia.org/ontology/Actor> ;
            sh:path <http://dbpedia.org/ontology/starring> ] ;
    sh:targetClass <http://dbpedia.org/ontology/ComicsCharacter> .

