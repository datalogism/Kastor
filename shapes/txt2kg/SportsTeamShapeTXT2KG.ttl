@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/SportsTeamShape> a sh:NodeShape ;
    sh:property [ sh:datatype rdf:langString ;
            sh:path <http://dbpedia.org/ontology/demonym> ],
        [ sh:class <http://dbpedia.org/ontology/Mayor> ;
            sh:path <http://dbpedia.org/ontology/mayor> ],
        [ sh:path <http://dbpedia.org/ontology/isPartOf> ],
        [ sh:path <http://dbpedia.org/ontology/operator> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/leader> ],
        [ sh:class <http://dbpedia.org/ontology/City> ;
            sh:path <http://dbpedia.org/ontology/capital> ],
        [ sh:path <http://dbpedia.org/ontology/nickname> ],
        [ sh:path <http://dbpedia.org/ontology/season> ],
        [ sh:class <http://dbpedia.org/ontology/Organisation> ;
            sh:path <http://dbpedia.org/ontology/tenant> ],
        [ sh:class <http://dbpedia.org/ontology/Agent> ;
            sh:path <http://dbpedia.org/ontology/owner> ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:path <http://dbpedia.org/ontology/location> ],
        [ sh:class <http://dbpedia.org/ontology/Country> ;
            sh:path <http://dbpedia.org/ontology/country> ],
        [ sh:datatype rdf:langString ;
            sh:path <http://dbpedia.org/ontology/chairmanTitle> ],
        [ sh:class <http://dbpedia.org/ontology/SportsTeam> ;
            sh:path <http://dbpedia.org/ontology/club> ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:path <http://dbpedia.org/ontology/birthPlace> ],
        [ sh:path <http://dbpedia.org/ontology/champions> ],
        [ sh:class <http://dbpedia.org/ontology/Language> ;
            sh:path <http://dbpedia.org/ontology/language> ],
        [ sh:class <http://dbpedia.org/ontology/Place> ;
            sh:path <http://dbpedia.org/ontology/ground> ],
        [ sh:class <http://dbpedia.org/ontology/SportsLeague> ;
            sh:path <http://dbpedia.org/ontology/league> ],
        [ sh:class <http://dbpedia.org/ontology/City> ;
            sh:path <http://dbpedia.org/ontology/city> ],
        [ sh:class <http://dbpedia.org/ontology/Person> ;
            sh:path <http://dbpedia.org/ontology/manager> ],
        [ sh:class <http://dbpedia.org/ontology/PopulatedPlace> ;
            sh:path <http://dbpedia.org/ontology/state> ],
        [ sh:path <http://dbpedia.org/ontology/fullName> ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:path <http://dbpedia.org/ontology/numberOfMembers> ] ;
    sh:targetClass <http://dbpedia.org/ontology/SportsTeam> .

